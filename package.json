{
  "name": "ossuary",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "test": "bun packages/ossuary-core/scripts/test-tz.ts --all",
    "test:tz": "bun packages/ossuary-core/scripts/test-tz.ts",
    "test:one": "vitest run",
    "hook:engine": "vitest run packages/ossuary-core/src/engine packages/ossuary-core/src/schema",
    "hook:boundary": "bun scripts/check-boundary.ts",
    "hook:spec": "bun scripts/check-specs.ts",
    "typecheck": "tsc -b",
    "e2e": "playwright test",
    "dev": "bun run dev:pantry",
    "dev:pantry": "vite apps/pantry-reaper --port 5173 --strictPort",
    "data:pantry": "bun apps/pantry-reaper/scripts/build-foods.ts",
    "build:pantry": "vite build apps/pantry-reaper",
    "preview:pantry": "vite preview apps/pantry-reaper --port 4173 --strictPort",
    "dev:wraith": "vite apps/warranty-wraith --port 5174 --strictPort",
    "data:wraith": "bun apps/warranty-wraith/scripts/build-recalls.ts",
    "icons:wraith": "bun apps/warranty-wraith/scripts/draw-icons.ts",
    "build:wraith": "vite build apps/warranty-wraith",
    "preview:wraith": "vite preview apps/warranty-wraith --port 4174 --strictPort",
    "dev:gallery": "vite packages/ossuary-core/gallery --port 5180 --strictPort",
    "build":"vite build apps/pantry-reaper && vite build apps/warranty-wraith",
    "playwright:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
